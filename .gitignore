node_modules/
.next/
out/
build/
dist/

# env files — ignore EVERY variant (.env, .env.local, .env.production,
# .env.flamekeeper, .env.bak, ...). Only the template is tracked.
# A file like `.env.flamekeeper` previously slipped past the narrower
# patterns and got staged with real secrets — keep this broad.
.env
.env.*
!.env.example

# database
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal
# Generated at docker build time from schema.prisma (do not commit)
prisma/init.sql

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tooling metadata (user-specific, not for source control)
.reasonix/
.claude/
# 桌面 AI 工具的附件目录（无点前缀的那个）。曾经出现过剪贴板附件被写进来，
# 因为不在忽略列表里，一次 `git add -A` 就会误入库。
reasonix/

# Logs
*.log
npm-debug.log*

# Temporary
tmp/
temp/
# TypeScript incremental build cache
*.tsbuildinfo

# Member-uploaded attachments (runtime data, not source)
public/uploads/*
!public/uploads/.gitkeep

# WTF 上传的私有存储（运行时数据，不入库）
storage/
