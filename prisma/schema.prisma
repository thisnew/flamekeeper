generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  emailVerified  DateTime?
  passwordHash   String
  name           String?
  image          String?
  role           String               @default("USER") // VISITOR | USER | MEMBER | OFFICER | ADMIN
  status         String               @default("PENDING_EMAIL") // PENDING_EMAIL | PENDING_APPROVAL | APPROVED | REJECTED | NEEDS_INFO
  /// 会阶（公会内部头衔），与上面的系统权限 role 完全解耦：
  ///   role      = 能不能进后台 / 改设置（系统权限）
  ///   guildRank = 在公会里是什么身份（展示用 + 招募语境）
  /// 注意：管理员（ADMIN）**不等于**会长，二者是两个维度。
  guildRank      String               @default("MEMBER") // LEADER 会长 | RAID_LEADER 团长 | CORE 核心 | MEMBER 成员
  referredById   String? // who approved/referred this member
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  referredBy     User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referrals      User[]               @relation("UserReferrals")
  applications   Application[]
  profile        Profile?
  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  characters     Character[]
  eventSignups   EventSignup[]
  auditLogs      AuditLog[]
  passwordResets PasswordResetToken[]
  comments       Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 密码重置令牌。
/// 只存 token 的 SHA-256 摘要 —— 即使数据库泄露，也无法直接用它改密码。
/// 一次性使用（usedAt），默认 1 小时过期，改密后同用户的其余令牌一并作废。
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id              String   @id @default(cuid())
  userId          String
  characterName   String
  server          String
  faction         String // Alliance | Horde
  class           String // Warrior | Paladin | Hunter | Rogue | Priest | DK | Shaman | Mage | Warlock | Monk | Druid | DH | Evoker
  spec            String
  itemLevel       Int?
  raidExperience  String?
  playableTimes   String?
  kookId          String?
  wechatId        String?
  applicationCode String   @unique
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | NEEDS_INFO
  officerNote     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  content        String // Markdown
  excerpt        String?
  coverImage     String?
  category       String // NEWS | ANNOUNCEMENT | BATTLE_REPORT | EVENT | RECRUITMENT | MAINTENANCE | SHARING
  tags           String? // comma-separated
  isPinned       Boolean   @default(false)
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  viewCount      Int       @default(0)
  attachmentUrl  String? // member-uploaded file (<= 10MB)
  attachmentName String?
  attachmentSize Int?
  authorId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User      @relation(fields: [authorId], references: [id])
  comments       Comment[]
}

/// 文章评论。
/// status 默认 PENDING —— 需要官员审核后才对所有人可见（可在系统设置里
/// 用 `comment_moderation` 关掉；官员/管理员自己发的评论始终直接通过）。
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([status])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String // Markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id           String   @id @default(cuid())
  name         String
  server       String
  faction      String
  class        String
  spec         String
  role         String // Tank | Healer | DPS
  level        Int      @default(80)
  itemLevel    Int?
  mythicScore  Int?
  raidProgress String?
  status       String   @default("ACTIVE") // ACTIVE | BENCH | CASUAL | LEFT
  isPublic     Boolean  @default(true)
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
}

model RaidProgress {
  id         String   @id @default(cuid())
  raidName   String
  bossName   String
  difficulty String // Normal | Heroic | Mythic
  defeatedAt DateTime
  createdAt  DateTime @default(now())
}

model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  snapshotDate DateTime @unique
  data         String // JSON blob
  createdAt    DateTime @default(now())
}

model Addon {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  category        String // RAID | MPLUS | PVP | UI | CLASS | WEAKAURA | MACRO | TOOL
  applicableClass String? // comma-separated classes
  gameVersion     String?
  downloadUrl     String?
  waString        String? // WeakAuras import string
  tutorialContent String? // Markdown tutorial
  screenshotUrl   String?
  isRecommended   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  eventType   String // RAID | MPLUS | PVP | SOCIAL | OTHER
  startTime   DateTime
  endTime     DateTime
  maxSlots    Int?
  location    String? // in-game zone / voice channel
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  signups     EventSignup[]
}

model EventSignup {
  id         String    @id @default(cuid())
  eventId    String
  userId     String
  status     String    @default("CONFIRMED") // CONFIRMED | BENCH | CANCELLED
  /// 出勤（PLAN.md：event_signups 含「报名与出勤」）
  /// null = 尚未标记 | ATTENDED 已出席 | ABSENT 缺席 | LEAVE 已请假
  attendance String?
  markedAt   DateTime?
  /// 报名备注（想玩的专精 / 替补说明等）
  note       String?
  createdAt  DateTime  @default(now())
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Media {
  id        String   @id @default(cuid())
  title     String?
  url       String
  type      String // IMAGE | VIDEO
  album     String? // gallery album name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  detail    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
