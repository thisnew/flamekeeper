generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  emailVerified  DateTime?
  passwordHash   String
  name           String?
  image          String?
  role           String               @default("USER") // VISITOR | USER | MEMBER | OFFICER | ADMIN
  status         String               @default("PENDING_EMAIL") // PENDING_EMAIL | PENDING_APPROVAL | APPROVED | REJECTED | NEEDS_INFO
  /// 会阶（公会内部头衔），与上面的系统权限 role 完全解耦：
  ///   role      = 能不能进后台 / 改设置（系统权限）
  ///   guildRank = 在公会里是什么身份（展示用 + 招募语境）
  /// 注意：管理员（ADMIN）**不等于**会长，二者是两个维度。
  guildRank      String               @default("MEMBER") // LEADER 会长 | RAID_LEADER 团长 | CORE 核心 | MEMBER 成员
  referredById   String? // who approved/referred this member
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  referredBy     User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referrals      User[]               @relation("UserReferrals")
  applications   Application[]
  profile        Profile?
  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  characters     Character[]
  eventSignups   EventSignup[]
  auditLogs      AuditLog[]
  passwordResets PasswordResetToken[]
  comments       Comment[]
  wtfAccounts    WtfAccount[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 密码重置令牌。
/// 只存 token 的 SHA-256 摘要 —— 即使数据库泄露，也无法直接用它改密码。
/// 一次性使用（usedAt），默认 1 小时过期，改密后同用户的其余令牌一并作废。
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id              String   @id @default(cuid())
  userId          String
  /// ---- 游戏信息：注册流程不再收集（只填昵称）----
  /// 改为可空以兼容历史数据，并给将来「申请时可选填」留余地。
  /// 角色由 WTF 导入或后台名册维护产生，不再从申请里自动创建。
  characterName   String?
  server          String?
  faction         String?
  class           String?
  spec            String?
  itemLevel       Int?
  raidExperience  String?
  playableTimes   String?
  kookId          String?
  wechatId        String?
  applicationCode String   @unique
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | NEEDS_INFO
  officerNote     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  content        String // Markdown
  excerpt        String?
  coverImage     String?
  category       String // NEWS | ANNOUNCEMENT | BATTLE_REPORT | EVENT | RECRUITMENT | MAINTENANCE | SHARING
  tags           String? // comma-separated
  isPinned       Boolean   @default(false)
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  viewCount      Int       @default(0)
  attachmentUrl  String? // member-uploaded file (<= 10MB)
  attachmentName String?
  attachmentSize Int?
  authorId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User      @relation(fields: [authorId], references: [id])
  comments       Comment[]
}

/// 文章评论。
/// status 默认 PENDING —— 需要官员审核后才对所有人可见（可在系统设置里
/// 用 `comment_moderation` 关掉；官员/管理员自己发的评论始终直接通过）。
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([status])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String // Markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id            String       @id @default(cuid())
  name          String
  server        String
  /// WTF 导入只能拿到「账号/服务器/角色名」，职业专精这些拿不到，
  /// 因此以下四项改为可空 —— 由成员在个人资料里补全，或缺省显示。
  faction       String?
  class         String?
  spec          String?
  role          String? // Tank | Healer | DPS
  level         Int          @default(80)
  itemLevel     Int?
  mythicScore   Int?
  raidProgress  String?
  status        String       @default("ACTIVE") // ACTIVE | BENCH | CASUAL | LEFT
  isPublic      Boolean      @default(true)
  /// 来自哪个 WTF 账号（形如 NZY900202），手工添加的角色为 null
  accountName   String?
  /// 个人中心里的角色排序（小的在前）
  sortOrder     Int          @default(0)
  /// 是否为主力。**每人最多一个**（设为新主力会自动取消旧的）。
  /// 公会名单默认只展示主力。
  isMain        Boolean      @default(false)
  /// 命中的公会成员记录（由 Raider.IO 导入）。为 null = 不是公会成员，
  /// 因此**不能设为主力、也不出现在公会名单里**。
  guildMemberId String?
  userId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User?        @relation(fields: [userId], references: [id])
  guildMember   GuildMember? @relation(fields: [guildMemberId], references: [id], onDelete: SetNull)

  /// ⚠ **同一服务器的角色名全站唯一** —— 一个魔兽角色在游戏里只属于一个人，
  /// 不允许两个人各自认领同一个角色（既会重复统计，也给冒充留口子）。
  /// 注意 `server` 存的是字典里的**中文规范名**：若「回音山」与「Echo Ridge」
  /// 并存，唯一性就会被绕过，所以写入前统一经 `canonicalRealmName()` 归一。
  @@unique([server, name])
  @@index([userId, sortOrder])
  @@index([guildMemberId])
  @@index([userId, isMain])
}

/// 通过 Raider.IO 导入的**公会成员角色** —— 公会名单的权威来源。
///
/// 只有这里的角色才算「公会成员」：可以绑定到站内用户、可以设为主力、
/// 会出现在公会名单里。WTF 导入的角色若匹配不上这里，仍可存为个人角色，
/// 但**不进公会名单、不能设为主力**。
///
/// 实测要点（region=cn / 回音山 / Eternal Flame，257 名成员）：
///   - 角色名多为**中文**（君少、月影长安），与 WTF 目录名一致，可直接匹配
///   - Raider.IO 的 realm 是**英文 Title**（"Echo Ridge"），而 WTF 是中文（回音山），
///     所以额外存一个归一化的 `realmSlug`（echo-ridge）做对齐
///   - 成员可分布在多个服务器（实测 60 个），故唯一键必须带服务器
model GuildMember {
  id            String    @id @default(cuid())
  /// 角色名（国服多为中文）
  characterName String
  /// Raider.IO 返回的服务器名（英文 Title，如 "Echo Ridge"）
  realmTitle    String
  /// 归一化服务器 slug（如 echo-ridge）—— 中文名与英文 Title 都往它对齐
  realmSlug     String
  region        String    @default("cn")
  className     String?
  specName      String?
  /// TANK | HEALER | DPS（Raider.IO 是大写）
  specRole      String?
  /// 公会内部职级（数字，越小越高）
  rank          Int?
  guildName     String?
  profileUrl    String?
  /// Raider.IO 对该角色的最后抓取时间
  lastCrawledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  characters Character[]

  @@unique([region, realmSlug, characterName])
  @@index([characterName])
  @@index([region])
}

/// 成员上传过的 WTF 账号目录。每位成员最多 5 个。
///
/// 网页无法读取本地路径（浏览器安全沙箱），所以靠 `<input webkitdirectory>`
/// 让用户主动选目录，再从相对路径解析出 账号/服务器/角色名 三层目录名。
/// **只保存目录名，不保存任何文件内容。**
model WtfAccount {
  id          String   @id @default(cuid())
  userId      String
  /// 账号目录名，例如 NZY900202
  accountName String
  /// 上次解析到的服务器数量（展示用）
  realmCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountName])
  @@index([userId])
}

/// 国服服务器（大区/服务器）字典。
///
/// 数据来自暴雪国服接口，由管理员在后台手动定期更新：
///   https://webapi.blizzard.cn/wow-armory-server/api/server_status?server_type=wow_mainline
///
/// 用途：其它功能需要「中文服务器名 ↔ 短写英文名」的对应关系 ——
/// 例如 WTF 导入的角色目录名是中文（破碎岭），而 Raider.IO 等接口要英文 slug
/// （broken-peaks）。存本地是为了**不依赖外部接口可用性**，查表即可。
///
/// 注意：接口里的 `id` 是**服务器组**（多个服务器共享同一个 id），
/// 真正唯一的键是 `name` 与 `slug`。
model GameRealm {
  id             String   @id @default(cuid())
  /// 中文服务器名，如「燃烧之刃」—— 与 WTF 目录名一致，是主要查找键
  name           String   @unique
  /// 短写英文名（slug），如 burning-blade —— 供外部 API 使用
  slug           String   @unique
  /// 暴雪服务器组 id（不唯一）
  groupId        Int?
  /// 大区：一区 / 三区 / 五区 / 十区 / 推荐服务器
  category       String?
  typeName       String? // 普通 / RP
  typeType       String?
  populationName String? // 低 / 中 / 高 / 满
  populationType String?
  statusName     String? // 正常 / 维护
  statusType     String? // UP / DOWN
  locale         String?
  timezone       String?
  region         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

model RaidProgress {
  id         String   @id @default(cuid())
  raidName   String
  bossName   String
  difficulty String // Normal | Heroic | Mythic
  defeatedAt DateTime
  createdAt  DateTime @default(now())
}

model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  snapshotDate DateTime @unique
  data         String // JSON blob
  createdAt    DateTime @default(now())
}

model Addon {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  category        String // RAID | MPLUS | PVP | UI | CLASS | WEAKAURA | MACRO | TOOL
  applicableClass String? // comma-separated classes
  gameVersion     String?
  downloadUrl     String?
  waString        String? // WeakAuras import string
  tutorialContent String? // Markdown tutorial
  screenshotUrl   String?
  isRecommended   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  eventType   String // RAID | MPLUS | PVP | SOCIAL | OTHER
  startTime   DateTime
  endTime     DateTime
  maxSlots    Int?
  location    String? // in-game zone / voice channel
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  signups     EventSignup[]
}

model EventSignup {
  id         String    @id @default(cuid())
  eventId    String
  userId     String
  status     String    @default("CONFIRMED") // CONFIRMED | BENCH | CANCELLED
  /// 出勤（PLAN.md：event_signups 含「报名与出勤」）
  /// null = 尚未标记 | ATTENDED 已出席 | ABSENT 缺席 | LEAVE 已请假
  attendance String?
  markedAt   DateTime?
  /// 报名备注（想玩的专精 / 替补说明等）
  note       String?
  createdAt  DateTime  @default(now())
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Media {
  id        String   @id @default(cuid())
  title     String?
  url       String
  type      String // IMAGE | VIDEO
  album     String? // gallery album name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  detail    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
