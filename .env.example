AUTH_SECRET="your-secret-here"
# AUTH_URL is the public origin the app is served from.
# Override in .env for production (HTTPS reverse proxy / NAT mapping / CDN).
# Default below is the public deployment URL for this project.
AUTH_URL="https://www.h83c4578f.nyat.app"
NEXT_PUBLIC_APP_URL="https://www.h83c4578f.nyat.app"

# ---- Database (PostgreSQL) ----
# Local dev: `docker compose up -d db` (binds 127.0.0.1:5432).
# Production: override DATABASE_URL to point at the LAN database server
# (the in-container `db` service is not reachable from a remote host).
DATABASE_URL="postgresql://flamekeeper:flamekeeper_pg_pw@localhost:5432/flamekeeper?schema=public"
# Example remote DB:
# DATABASE_URL="postgresql://flamekeeper:<STRONG_PW>@192.168.3.80:5432/flamekeeper?schema=public"

# ---- PostgreSQL 容器（docker compose 的 db 服务）----
POSTGRES_USER="flamekeeper"
POSTGRES_PASSWORD="change-this-db-password"
POSTGRES_DB="flamekeeper"

# ---- Initial admin account (used by `npm run db:seed`) ----
ADMIN_EMAIL="flamekeeper_admin@163.com"
ADMIN_PASSWORD="change-this-strong-password"

# ---- Outbound mail (SMTP) ----
# For 163/126 mail use the 授权码 (SMTP auth code), NOT the login password.
SMTP_HOST="smtp.163.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="flamekeeper_admin@163.com"
SMTP_PASS="your-smtp-auth-code"
SMTP_FROM_NAME="Eternal Flame 守焰者"